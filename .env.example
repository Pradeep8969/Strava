EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
# Enable only after installing SDK modules and activating the native push adapter.
EXPO_PUBLIC_PUSH_ENABLED=false
# Server-only: set through Supabase secrets, NEVER EXPO_PUBLIC_
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# REVENUECAT_SECRET_KEY=
# REVENUECAT_WEBHOOK_SECRET=
# PUSH_WORKER_SECRET=  # server-only, random 32+ characters
# EXPO_ACCESS_TOKEN=   # server-only Expo push enhanced-security token

# Web Explore map: restricted public MapTiler key (never a server secret)
EXPO_PUBLIC_MAPTILER_KEY=
# Explicit localhost-only MapLibre development style; keep false in production
EXPO_PUBLIC_MAP_DEVELOPMENT=false
